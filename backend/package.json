{
  "name": "kfone-api-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "checkerrors": " echo 'Please wait...' && echo '  Please check below errors.' && echo '    if needed, do    npm i' && echo '    if needed, use   // eslint-disable-line   on same line as error.' && npm run lint:fix && npm run format && npm run build   && echo 'done.'",
    "checkerrors2": "echo 'Please wait...' && echo '  Please check below errors.' && echo '    if needed, do    npm i' && echo '    if needed, use   // eslint-disable-line   on same line as error.' && npm run lint:fix && npm run format && npm run build   && echo 'done.'",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings 0 --cache --cache-location ./node_modules/.cache/eslint/",
    "lint:debug": "eslint . --debug --no-cache",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "cd .. && husky backend/.husky"
  },
  "lint-staged": {
    "{src,test}/**/*.@(ts)": [
      "npm run lint:fix",
      "npm run format"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.624.0",
    "@aws-sdk/client-ses": "^3.716.0",
    "@aws-sdk/credential-provider-node": "^3.624.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kfone-common-library": "^1.0.5",
    "kfone-mq-library":"^0.1.3",
    "mustache": "^4.2.0",
    "nest-typed-config": "^2.9.3",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^modules$": "<rootDir>/modules",
      "^controllers$": "<rootDir>/controllers",
      "^services$": "<rootDir>/services",
      "^repositories$": "<rootDir>/repositories",
      "^dtos$": "<rootDir>/dtos",
      "^entities$": "<rootDir>/entities",
      "^config$": "<rootDir>/config",
      "^utilities$": "<rootDir>/utilities"
    }
  }
}
